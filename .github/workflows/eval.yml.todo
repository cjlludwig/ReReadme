# Planned CI workflow for rereadme evaluations
# Rename to eval.yml when ready to activate
#
# Triggers on PRs that modify pipeline-affecting files.
# Requires OPENAI_API_KEY in repository secrets.

name: Evaluate README Quality

on:
  pull_request:
    paths:
      - "script.ts"
      - "lib/**"
      - "templates/**"

jobs:
  eval:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive

      - uses: actions/setup-node@v4
        with:
          node-version: "20"

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install uv
        uses: astral-sh/setup-uv@v4

      - name: Install Node dependencies
        run: npm ci

      - name: Install Python dependencies
        run: cd experiments && uv sync

      - name: Run evaluations
        env:
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
        run: npm run eval
